{
  "name" : "aries-source",
  "config" : {
    "connector.class" : "com.github.jcustenborder.kafka.connect.spooldir.SpoolDirCsvSourceConnector",
    "tasks.max" : "1",
    "topic" : "aries-topic",
    "input.path" : "/tmp/input",
    "finished.path" : "/tmp/finished",
    "error.path" : "/tmp/error",
    "input.file.pattern" : "aries.*\\.csv",
    "csv.first.row.as.header" : "true",
    "schema.generation.enabled" : "false",
    "key.schema" : "{\"name\":\"Aries\",\"type\":\"STRUCT\",\"isOptional\":true,\"fieldSchemas\":{}}",
    "value.schema" : "{\"name\":\"Aries\",\"type\":\"STRUCT\",\"isOptional\":false,\"fieldSchemas\":{\"order_id\":{\"type\":\"INT32\",\"isOptional\":true},\"customer_name\":{\"type\":\"STRING\",\"isOptional\":true},\"amount\":{\"type\":\"INT32\",\"isOptional\":true}}}"
  }
}