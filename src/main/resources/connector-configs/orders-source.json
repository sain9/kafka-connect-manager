{
  "name": "orders-source",
  "config": {
    "connector.class": "com.github.jcustenborder.kafka.connect.spooldir.SpoolDirCsvSourceConnector",

    "tasks.max": "1",

    "topic": "orders-topic",

    "input.path": "/tmp/input",
    "finished.path": "/tmp/finished",
    "error.path": "/tmp/error",

    "input.file.pattern": "orders.*\\.csv",

    "csv.first.row.as.header": "true",

    "schema.generation.enabled": "false",

    "key.schema": "{\"name\":\"OrderKey\",\"type\":\"STRUCT\",\"isOptional\":true,\"fieldSchemas\":{}}",

    "value.schema": "{\"name\":\"Order\",\"type\":\"STRUCT\",\"isOptional\":false,\"fieldSchemas\":{\"order_id\":{\"type\":\"INT64\",\"isOptional\":false},\"customer_name\":{\"type\":\"STRING\",\"isOptional\":false},\"amount\":{\"type\":\"INT64\",\"isOptional\":false}}}"
  }
}